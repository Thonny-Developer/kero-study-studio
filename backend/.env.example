# Ключ Mistral AI (https://console.mistral.ai/api-keys)
MISTRAL_API_KEY=
# Модель для оценки промптов и текстов. Какие модели реально доступны ключу: npm run models
MISTRAL_MODEL=ministral-14b-latest
# Модель для генерации HTML и кода в проектах
MISTRAL_CODE_MODEL=codestral-latest

# БД: локально файл SQLite, в проде — Turso (libsql://…)
DATABASE_URL=file:./data/vibely.db
DATABASE_AUTH_TOKEN=

# Адрес фронта, с которого разрешены запросы (через запятую). Пусто — любой.
CORS_ORIGIN=

PORT=8787
