# Ключ Mistral AI (https://console.mistral.ai/api-keys)
MISTRAL_API_KEY=
# Модель для оценки промптов и текстов. Какие модели реально доступны ключу: npm run models
MISTRAL_MODEL=ministral-14b-latest
# Модель для генерации HTML и кода в проектах
MISTRAL_CODE_MODEL=codestral-latest

# БД: локально файл SQLite, в проде — Turso (libsql://…)
DATABASE_URL=file:./data/vibely.db
DATABASE_AUTH_TOKEN=

# Адрес фронта, с которого разрешены запросы (через запятую). Пусто — любой.
CORS_ORIGIN=

PORT=8787

# Почта: коды подтверждения и сброса пароля (Gmail — пароль приложения, не обычный пароль)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# true на 587 — STARTTLS; для 465 соединение сразу шифрованное
SMTP_TLS=true
SMTP_USER=
SMTP_PASSWORD=
# Имя отправителя или полный адрес: "Vibely <hello@vibely.app>"
MAIL_FROM=Kero Vibely
# Куда вернуть юзера после кнопки в письме (адрес фронта). Пусто — тот же хост, что принял запрос
APP_URL=
